<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF161616">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Disk Yönetimi" android:textColor="#B8FF1A" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/diskInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="#EEEEEE" android:textSize="13sp" android:lineSpacingExtra="6dp"
            android:fontFamily="monospace" />
        <ProgressBar android:id="@+id/diskBar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="12dp"
            android:max="100" android:progress="0" android:progressTint="#B8FF1A" />
        <TextView android:id="@+id/diskOpenFiles" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="16dp" android:gravity="center" android:background="@drawable/bg_choice"
            android:text="Dosya Gezgini'ni aç" android:textColor="#B8FF1A" />
    </LinearLayout>
</ScrollView>
