<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_desktop_overlay" />

    <FrameLayout
        android:id="@+id/desktop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <com.astrasage.os.SelectionOverlay
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_top_glass">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AstraSage OS"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#A0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Masaüstü"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search"
            android:hint="@string/search_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:layout_marginBottom="64dp"
        android:padding="10dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:background="#CC050507" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_taskbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="16dp">

        <LinearLayout
            android:id="@+id/btnStart"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:gravity="center"
            android:background="@drawable/bg_start_btn">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AS"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAst"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ast_icon"
                android:scaleType="centerCrop"
                android:contentDescription="AST" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AST"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📁"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dosyalar"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="@color/text"
                android:textSize="16sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tümü"
                android:textColor="@color/text_dim"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDesktop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackgroundBorderless">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masaüstü"
                android:textColor="@color/accent"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/startMenu"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="72dp"
        android:orientation="vertical"
        android:background="@drawable/bg_start_menu"
        android:padding="12dp"
        android:elevation="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Başlat"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/menuAst"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="  AST Terminal"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuFiles"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="  Dosya Gezgini"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuAll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="  Tüm uygulamalar"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="#22FFFFFF" />

        <TextView
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="  Bu cihaz hakkında"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:text="  Oturumu kapat"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</FrameLayout>
