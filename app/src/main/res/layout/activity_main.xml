<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_desktop_overlay" />

    <FrameLayout
        android:id="@+id/desktop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <com.astrasage.os.SelectionOverlay
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:visibility="invisible" />

    <!-- Floating windows host -->
    <FrameLayout
        android:id="@+id/windowsHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        android:clipChildren="false" />

    <!-- Welcome overlay -->
    <FrameLayout
        android:id="@+id/welcomeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC050507"
        android:visibility="gone"
        android:elevation="40dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_window">
            <include layout="@layout/panel_welcome" />
        </LinearLayout>
    </FrameLayout>

    <!-- Taskbar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_taskbar"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:elevation="20dp">

        <LinearLayout
            android:id="@+id/btnStart"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@drawable/bg_start_btn">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AS"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/taskbarApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/clockView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:textColor="@color/text"
            android:textSize="11sp"
            android:lineSpacingExtra="1dp"
            android:text="12:00\n1 Oca" />
    </LinearLayout>

    <!-- Start menu -->
    <LinearLayout
        android:id="@+id/startMenu"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical"
        android:background="@drawable/bg_start_menu"
        android:padding="12dp"
        android:elevation="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Başlat"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <TextView android:id="@+id/menuAst" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  AST Terminal"
            android:textColor="@color/text" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/menuFiles" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  Dosya Gezgini"
            android:textColor="@color/text" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/menuThisPc" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  Bu Bilgisayar"
            android:textColor="@color/text" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/menuTrash" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  Çöp Kutusu"
            android:textColor="@color/text" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <TextView android:id="@+id/menuCalendar" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  Takvim / Saat"
            android:textColor="@color/text" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="6dp" android:background="#22FFFFFF" />
        <TextView android:id="@+id/menuLogout" android:layout_width="match_parent" android:layout_height="42dp"
            android:gravity="center_vertical" android:paddingStart="8dp" android:text="  Oturumu kapat"
            android:textColor="@color/danger" android:textSize="14sp" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
</FrameLayout>
