<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121820">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">
        <TextView android:id="@+id/weatherCity" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Konum" android:textColor="#B8FF1A" android:textSize="16sp" />
        <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="--" android:textColor="#FFFFFF" android:textSize="48sp" android:textStyle="bold" />
        <TextView android:id="@+id/weatherDesc" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Yükleniyor…" android:textColor="#CCFFFFFF" android:textSize="14sp" />
        <TextView android:id="@+id/weatherExtra" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textColor="#AAFFFFFF" android:textSize="13sp" android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/weatherRefresh" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="16dp" android:gravity="center" android:background="@drawable/bg_choice"
            android:text="Yenile" android:textColor="#B8FF1A" />
    </LinearLayout>
</ScrollView>
