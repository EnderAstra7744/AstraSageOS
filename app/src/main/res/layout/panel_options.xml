<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A1A">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seçenekler"
            android:textColor="#B8FF1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İkon boyutu"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/optIconValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />
        <SeekBar
            android:id="@+id/optIconSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yazı boyutu (isimler)"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/optFontValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />
        <SeekBar
            android:id="@+id/optFontSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İkon isimlerini göster"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/optNamesOn"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_choice_sel"
                android:text="Açık"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/optNamesOff"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_choice"
                android:text="Kapalı"
                android:textColor="#EEEEEE"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arka plan"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />
        <TextView
            android:id="@+id/optWallPick"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@drawable/bg_choice"
            android:text="🖼️ Galeriden seç"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/optWallDefault"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/bg_choice"
            android:text="Varsayılan arka plan"
            android:textColor="#B8FF1A"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masaüstü uygulamaları"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />
        <TextView
            android:id="@+id/optAppsPick"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@drawable/bg_choice"
            android:text="📱 Hangi uygulamalar görünsün?"
            android:textColor="#EEEEEE"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/optApply"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_primary_btn"
            android:text="Uygula"
            android:textColor="#0A0A0C"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
