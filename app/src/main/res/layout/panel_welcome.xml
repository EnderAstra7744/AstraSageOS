<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoş geldin 👋"
            android:textColor="@color/accent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="AstraSage OS masaüstünü kişiselleştir"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/btnThemeDark"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:background="@drawable/bg_choice_sel"
                android:text="🌙 Koyu"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnThemeLight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:background="@drawable/bg_choice"
                android:text="☀️ Açık"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yazı boyutu"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <TextView android:id="@+id/btnFontS" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center"
                android:background="@drawable/bg_choice" android:text="Küçük" android:textColor="@color/text" android:textSize="12sp" />
            <TextView android:id="@+id/btnFontM" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginHorizontal="4dp" android:gravity="center"
                android:background="@drawable/bg_choice_sel" android:text="Normal" android:textColor="@color/text" android:textSize="13sp" />
            <TextView android:id="@+id/btnFontL" android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center"
                android:background="@drawable/bg_choice" android:text="Büyük" android:textColor="@color/text" android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arka plan"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnPickWallpaper"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:background="@drawable/bg_choice"
            android:text="🖼️ Galeriden seç (isteğe bağlı)"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnDefaultWall"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="Varsayılan AstraSage arka planı"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="İzinler"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnGrantStorage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:background="@drawable/bg_choice"
            android:text="📁 Dosya sistemi izni ver"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/permStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="İzin durumu kontrol edilecek"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnWelcomeDone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:background="@drawable/bg_primary_btn"
            android:text="Masaüstüne geç"
            android:textColor="@color/bg_deep"
            android:textStyle="bold"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
