<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F00A0A0E"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tüm Uygulamalar"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/drawerHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Basılı tut → masaüstüne sürükle"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/btnCloseDrawer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawerGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
