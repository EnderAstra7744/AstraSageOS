<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1E1E1E">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#FF2A2A2A">
        <TextView android:id="@+id/noteNew" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingHorizontal="10dp" android:text="Yeni" android:textColor="#B8FF1A" android:textSize="12sp" />
        <TextView android:id="@+id/noteSave" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingHorizontal="10dp" android:text="Kaydet" android:textColor="#EEEEEE" android:textSize="12sp" />
        <TextView android:id="@+id/noteStatus" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="end" android:textColor="#88FFFFFF" android:textSize="11sp" />
    </LinearLayout>
    <EditText
        android:id="@+id/noteEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@android:color/transparent"
        android:textColor="#EEEEEE"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:inputType="textMultiLine|textCapSentences"
        android:hint="Not yazın…"
        android:textColorHint="#55FFFFFF" />
</LinearLayout>
