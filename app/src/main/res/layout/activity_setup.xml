<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Compact centered card, scrollable for landscape -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxWidth="420dp"
                android:orientation="vertical"
                android:background="@drawable/bg_setup_card"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:elevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:background="@drawable/bg_start_btn"
                        android:text="AS"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:id="@+id/setupTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AstraSage OS"
                            android:textColor="@color/text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/setupSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kurulum"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Step: Language -->
                <LinearLayout
                    android:id="@+id/stepLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTr"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:background="@drawable/bg_choice"
                        android:text="🇹🇷 Türkçe"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnEn"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:background="@drawable/bg_choice"
                        android:text="🇬🇧 English"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step: Account -->
                <LinearLayout
                    android:id="@+id/stepAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kullanıcı adı"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/inputUser"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_search"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_dim"
                        android:hint="ör. ahmet"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Şifre"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/inputPass"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_search"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_dim"
                        android:hint="en az 3 karakter"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:imeOptions="actionDone" />

                    <TextView
                        android:id="@+id/setupErr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/danger"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:minHeight="14dp" />

                    <TextView
                        android:id="@+id/btnFinish"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:background="@drawable/bg_primary_btn"
                        android:text="Giriş Yap"
                        android:textColor="@color/bg_deep"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnReset"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Hesabı sıfırla"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
