<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_window"
    android:elevation="16dp">

    <LinearLayout
        android:id="@+id/panelTitleBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="2dp"
        android:background="@drawable/bg_panel_title">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#EEEEEE"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Window" />

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="─"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnMaximize"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="□"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#E81123" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/panelContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF242424" />
</LinearLayout>
