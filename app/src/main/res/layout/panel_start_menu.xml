<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startMenuPanel"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_start_win11"
    android:elevation="28dp"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/startDragHandle"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Başlat  ·  sürükle"
            android:textColor="#B8FF1A"
            android:textStyle="bold"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⋮⋮"
            android:textColor="#66FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/startPinnedGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:useDefaultMargins="true"
        android:alignmentMode="alignBounds" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#22FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Önerilen"
        android:textColor="#88FFFFFF"
        android:textSize="11sp"
        android:paddingStart="4dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/startRecommended"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#22FFFFFF" />

    <!-- Power row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_as_logo"
            android:contentDescription="AS" />

        <TextView
            android:id="@+id/startUserLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Kullanıcı"
            android:textColor="#EEEEEE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPowerSleep"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="💤"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/btnPowerRestart"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🔄"
            android:textSize="14sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/btnPowerOff"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⏻"
            android:textSize="16sp"
            android:textColor="#FF6B6B"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
