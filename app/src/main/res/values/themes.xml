<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AstraSageOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dim</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="popupMenuStyle">@style/AsPopupMenu</item>
        <item name="android:popupMenuStyle">@style/AsPopupMenu</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:itemTextAppearance">@style/AsPopupText</item>
    </style>
    <style name="AsPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_dark</item>
    </style>
    <style name="AsPopupText" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textColor">#EEEEEE</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
