start;
func main(void) {
    l = [3, 1, 2];
    l.append(5); l.insert(0, 9); l.extend([7, 7]);
    assert l == [9, 3, 1, 2, 5, 7, 7];
    l.remove(7); assert l.count(7) == 1;
    assert l.pop() == 7 and l.pop(0) == 9;
    l.sort(); assert l == [1, 2, 3, 5];
    l.reverse(); assert l == [5, 3, 2, 1];
    assert l.index(2) == 2;
    l.clear(); assert len(l) == 0;
    assert sorted([3, 1, 2], reverse=True) == [3, 2, 1];
    assert sorted(["b", "a"], key=lambda x: x) == ["a", "b"];
    t = (1, 2, 3);
    assert t[1] == 2 and len(t) == 3 and t.count(2) == 1 and t.index(3) == 2;
    a, b = 1, 2;
    a, b = b, a;
    assert a == 2 and b == 1;
    s = {1, 2, 3};
    s.add(4); s.discard(1); s.remove(2);
    assert s == {3, 4};
    assert s.union({9}) == {3, 4, 9} and s.intersection({4, 5}) == {4} and s.difference({3}) == {4};
    assert s.symmetric_difference({4, 8}) == {3, 8};
    fs = frozenset([1, 2]);
    assert 1 in fs and len(fs) == 2;
    d = {"a": 1, "b": 2};
    d["c"] = 3;
    assert d.get("a") == 1 and d.get("z") is None and d.get("z", 0) == 0;
    assert list(d.keys()) == ["a", "b", "c"] and list(d.values()) == [1, 2, 3];
    assert list(d.items())[0] == ("a", 1);
    d.update({"a": 10}); assert d["a"] == 10;
    assert d.pop("a") == 10 and "a" not in d;
    d2 = dict(ad="Ali"); assert d2["ad"] == "Ali";
    b1 = bytes([65, 66]); assert len(b1) == 2;
    ba = bytearray(3); assert len(ba) == 3;
    assert list(enumerate(["x", "y"])) == [(0, "x"), (1, "y")];
    assert list(zip([1, 2], ["a", "b"])) == [(1, "a"), (2, "b")];
    assert list(map(lambda x: x + 1, [1, 2])) == [2, 3];
    assert list(filter(lambda x: x > 1, [1, 2, 3])) == [2, 3];
    assert all([1, 1]) and any([0, 1]) and not all([1, 0]);
    assert list(reversed([1, 2, 3])) == [3, 2, 1];
    m = [1, 2, 3, 4, 5];
    assert m[1:4] == [2, 3, 4] and m[::2] == [1, 3, 5] and m[-2:] == [4, 5];
    printc("collections ok");
    end;
};
end;
