start;
func f(x) { return x; end; };
func sayac(n) { i = 0; while i < n { yield i * 10; i += 1; end; }; end; };
class Daire {
    adet = 0;
    func init(self, r) { self._r = r; Daire.adet += 1; end; };
    func al_r(self) { return self._r; end; };
    func koy_r(self, v) { self._r = v; end; };
    r = property(al_r, koy_r);
    alan = property(lambda self: 3 * self._r * self._r);
    func yap(cls, r) { return cls(r); end; };
    yap = classmethod(yap);
    func iki(a) { return a * 2; end; };
    iki = staticmethod(iki);
};
func main(void) {
    assert 1 < 2 < 3 and not (3 < 2 < 5) and 1 < f(2) <= 2 and 1 == 1 != 2;
    assert [x * x for x in range(5)] == [0, 1, 4, 9, 16];
    assert [x for x in range(10) if x % 2 == 0 if x > 2] == [4, 6, 8];
    assert [(a, b) for a in range(2) for b in "xy"] == [(0, "x"), (0, "y"), (1, "x"), (1, "y")];
    assert {k: v for k, v in [("a", 1), ("b", 2)]} == {"a": 1, "b": 2};
    assert {x % 3 for x in range(10)} == {0, 1, 2};
    x = 99; r = [x for x in range(3)]; assert x == 99;
    d = Daire(2);
    assert d.r == 2 and d.alan == 12;
    d.r = 5; assert d.r == 5;
    e = Daire.yap(7);
    assert e.r == 7 and Daire.adet == 2 and d.yap(1).r == 1;
    assert Daire.iki(4) == 8 and d.iki(5) == 10;
    try { d.alan = 1; } except AttributeError { pass; };
    assert list(sayac(4)) == [0, 10, 20, 30];
    g = sayac(3);
    assert next(g) == 0 and next(g) == 10 and list(g) == [20] and next(g, "bitti") == "bitti";
    assert sum(sayac(3)) == 30 and [a + 1 for a in sayac(3)] == [1, 11, 21];
    it = iter([5, 6]);
    assert next(it) == 5 and next(it) == 6;
    try { next(it); } except StopIteration { pass; };
    with open("t_more_tmp.txt", "w") as fw { fw.write("one\ntwo\n"); fw.write("three"); end; };
    with open("t_more_tmp.txt") as frd { assert frd.readline() == "one\n"; assert frd.read() == "two\nthree"; end; };
    with open("t_more_tmp.txt", "a") as fa { fa.write("\nfour"); end; };
    fh = open("t_more_tmp.txt");
    assert len(fh.readlines()) == 4;
    fh.close();
    try { fh.read(); } except ValueError { pass; };
    try { open("no_such_file_zz.txt"); } except OSError { pass; };
    printc("more ok");
    end;
};
end;
