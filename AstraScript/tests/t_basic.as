start;
func fact(n) {
    if n <= 1 { return 1; };
    return n * fact(n - 1);
    end;
};
func main(void) {
    assert 1 + 2 * 3 == 7;
    assert 7 // 2 == 3 and 7 % 3 == 1 and 2 ** 10 == 1024;
    assert -7 // 2 == -4;
    assert 7 / 2 == 3.5;
    assert True and not False;
    assert None is None;
    assert fact(10) == 3628800;
    vr inter a = 3;
    a += 4; a *= 2;
    assert a == 14;
    s = "Merhaba";
    assert len(s) == 7;
    assert s[0] == "M" and s[-1] == "a" and s[1:3] == "er" and s[::-1] == "abahreM";
    assert "er" in s and "xx" not in s;
    n = 0;
    for i in range(5) { n += i; end; };
    assert n == 10;
    k = 0;
    while k < 10 { k += 1; if k == 5 { break; end; }; end; };
    assert k == 5;
    t = 0;
    for i in range(10) { if i % 2 == 0 { continue; end; }; t += i; end; };
    assert t == 25;
    if a > 100 { x = 1; } elif a > 10 { x = 2; } else { x = 3; };
    assert x == 2;
    assert (1 if a > 1 else 2) == 1;
    assert abs(-3) == 3 and max(1, 5, 3) == 5 and min([4, 2, 8]) == 2 and sum([1, 2, 3]) == 6;
    assert int("42") == 42 and flo("2.5") == 2.5 and strt(12) == "12" and bool(0) == False;
    assert round(2.5) == 2 and round(3.14159, 2) == 3.14;
    assert divmod(7, 2) == (3, 1);
    assert hex(255) == "0xff" and bin(5) == "0b101" and chr(65) == "A" and ord("A") == 65;
    assert type(3) is int;
    assert isinstance(3, int) and not isinstance("a", int);
    assert 2147483647 + 1 == 2147483648.0;
    assert 0.1 + 0.2 != 0.3;
    printc("basic ok");
    end;
};
end;
